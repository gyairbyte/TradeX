# ── OHLCV data provider ─────────────────────────────────────────────────────────
# Controls central OHLCV fetcher and date-ranged daily history.
# Options: yahoo (default, free), alpaca (free real-time), ibkr (requires TWS running), schwab
DATA_PROVIDER=yahoo

# Optional retry/fallback policy for OHLCV. Disabled by default.
# OHLCV_MAX_RETRIES=0      # extra attempts per ticker for transient failures only (max 3)
# OHLCV_FALLBACK_ORDER=    # comma-separated whole-scan fallback chain, e.g. "schwab,yahoo" (empty = disabled)

# ── Specialized source overrides (optional) ─────────────────────────────────────
# These are independent of DATA_PROVIDER. Leave unset to use the defaults shown.
# OPTIONS_DATA_SOURCE=auto       # auto | unusual_whales | tradier | yahoo
# EARNINGS_DATA_SOURCE=yahoo     # yahoo only in this release
# MARKET_CAP_DATA_SOURCE=yahoo   # yahoo | schwab

# ── Alpaca ────────────────────────────────────────────────────────────────────
# Sign up at https://alpaca.markets — free tier gives real-time IEX feed
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Interactive Brokers ───────────────────────────────────────────────────────
# Requires TWS or IB Gateway running locally with API connections enabled
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ── Charles Schwab (replaced TD Ameritrade Sept 2024) ────────────────────────
# Register app at https://developer.schwab.com — requires a Schwab brokerage account
# WARNING: Never commit this file or the OAuth token file to Git.
# Keep SCHWAB_TOKEN_PATH outside the project directory, e.g. under ~/.tradex_*
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_TOKEN_PATH=~/.tradex_schwab_token.json
# Optional smoke-test symbol for scripts/schwab_smoke_test.py
SCHWAB_SMOKE_SYMBOL=SPY

# ── Alerts — Discord ─────────────────────────────────────────────────────────
# 1. Go to https://discord.com/developers/applications → New Application
# 2. Bot tab → Add Bot → copy the Token below
# 3. OAuth2 → URL Generator → scopes: bot → permissions: Send Messages, Embed Links
# 4. Open the generated URL to invite the bot to your server
# 5. Right-click your alert channel → Copy Channel ID (enable Developer Mode first)
ALERT_DISCORD_TOKEN=
ALERT_DISCORD_CHANNEL_ID=

# ── Alerts — Email ────────────────────────────────────────────────────────────
# For Gmail: use an App Password (myaccount.google.com/apppasswords)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASS=

# ── Alert thresholds (edit to tune sensitivity) ───────────────────────────────
ALERT_COIL_THRESHOLD=60
ALERT_PATTERN_THRESHOLD=75
ALERT_CONFLUENCE_THRESHOLD=70

# ── Alert cooldown / deduplication ──────────────────────────────────────────────
# Enable persistent cooldown and deduplication for automatic alerts (coil, confluence, pattern, gap).
# Set to "false" to send every eligible alert without cooldown.
ALERT_COOLDOWN_ENABLED=true

# Default cooldown in minutes (1 to 10080). Applies to all alert types unless overridden below.
ALERT_COOLDOWN_MINUTES=60

# Optional per-type overrides. Unset = use default. Valid range: 1 to 10080.
# ALERT_COIL_COOLDOWN_MINUTES=60
# ALERT_CONFLUENCE_COOLDOWN_MINUTES=60
# ALERT_PATTERN_COOLDOWN_MINUTES=60
# ALERT_GAP_COOLDOWN_MINUTES=60

# Path to the isolated SQLite alert state database. Created on first eligible automatic alert.
ALERT_STATE_PATH=~/.tradex/alerts.db

# ── Persistence paths (optional) ───────────────────────────────────────────────
# These SQLite files are created on first use. Paths default to ~/.tradex/ and can
# be redirected to keep development/test data out of the home directory.
# TRADEX_DB_PATH=~/.tradex/signals.db
# TRADEX_FP_DB=~/.tradex/fingerprints.db
# TRADEX_WATCHLISTS_DB_PATH=~/.tradex/watchlists.db
# TRADEX_EARNINGS_CACHE_PATH=~/.tradex/earnings_cache.db

# ── Options activity ───────────────────────────────────────────────────────────
# Unusual Whales provides true options-flow events (sweeps, premium, side) when configured.
# Tradier and Yahoo provide options-chain snapshots only (volume, open interest, bid/ask/last).
# OPTIONS_DATA_SOURCE=auto       # auto | unusual_whales | tradier | yahoo
UNUSUAL_WHALES_API_KEY=
TRADIER_API_KEY=

# ── Optional: Polygon.io (future use) ────────────────────────────────────────
POLYGON_API_KEY=
