  "localization_and_decision_rules": {
    "hit_delta_definition": "hit_delta_t = candidate_clean_hits_t - baseline_clean_hits_t",
    "annual_hit_delta_definition": "annual_hit_delta = sum(hit_delta_t)",
    "negative_hit_loss_definition": "abs(hit_delta_segment) if hit_delta_segment < 0 else 0",
    "dominant_negative_segment_share_definition": "largest negative_hit_loss / sum(all negative_hit_loss values)",
    "remaining_segment_hit_delta_definition": "annual_hit_delta - dominant_segment_hit_delta",
    "localization_threshold": 0.60,
    "rule_a_calendar_localization": {
      "threshold": 0.60,
      "rule": "one 2020 calendar quarter accounts for >= 60% of total negative hit loss AND other three quarters combined have clean-hit delta >= 0"
    },
    "rule_b_market_context_localization": {
      "threshold": 0.60,
      "rule": "one SPY-return regime accounts for >= 60% of total negative hit loss AND other two SPY regimes combined have clean-hit delta >= 0"
    },
