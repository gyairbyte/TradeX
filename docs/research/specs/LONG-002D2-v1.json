    "step_2_common_population": "Observations where candidate feature is not-null, frozen VAM5 record exists, and clean_target_reached is not-null",
    "step_3_k_date": "Count of frozen VAM5 top_10_flag == True on that date within candidate common population",
    "step_4_matched_baseline": "Rank common population on date by frozen VAM5 ranking (cross_sectional_rank ASC, tie-break immutable_security_id ASC), select best K(date)",
    "step_5_candidate_pool": "Filter common population on date to VAM5 top_25_flag == True",
    "step_6_candidate_rerank": "Rank candidate pool on date by candidate feature HIGHER (descending), tie-break immutable_security_id ASC, select best K(date)",
