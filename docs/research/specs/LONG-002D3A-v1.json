  "strata_definitions": {
    "class_priority_precedence": [
      "positive_master_episode",
      "near_miss",
      "adverse_trap",
      "ordinary_non_mover"
    ],
    "classes": {
      "positive_master_episode": {
        "stratum_id": 1,
        "name": "positive_master_episode",
        "description": "Anchor observation of a valid Stage C master opportunity episode at the 20:30 snapshot",
        "source": "master_episodes.parquet",
        "anchor_cutoff_required": "20:30"
      },
      "near_miss": {
        "stratum_id": 2,
        "name": "near_miss",
        "description": "Observation outside any active positive master episode with near_miss == True and clean_target_reached == False on the primary (+10% / 10 sessions) cell",
        "source": "outcome_matrix.parquet (target_pct=10, horizon_sessions=10)",
        "conditions": {
          "outside_active_master_episode": true,
          "clean_target_reached": false,
          "near_miss": true
        }
      },
      "adverse_trap": {
        "stratum_id": 3,
        "name": "adverse_trap",
        "description": "Observation outside any active positive master episode not qualifying as near_miss with adverse_excursion == True and clean_target_reached == False on primary cell",
        "source": "outcome_matrix.parquet (target_pct=10, horizon_sessions=10)",
        "conditions": {
          "outside_active_master_episode": true,
          "clean_target_reached": false,
          "near_miss": false,
          "adverse_excursion": true
        }
      },
      "ordinary_non_mover": {
        "stratum_id": 4,
        "name": "ordinary_non_mover",
        "description": "Observation outside any active positive master episode not qualifying as near_miss or adverse_trap with target_progress_ratio < 0.50 and clean_target_reached == False on primary cell",
        "source": "outcome_matrix.parquet (target_pct=10, horizon_sessions=10)",
        "conditions": {
          "outside_active_master_episode": true,
          "clean_target_reached": false,
          "near_miss": false,
          "adverse_excursion": false,
          "target_progress_ratio_lt": 0.5
        }
      }
    }
  },
  "control_exclusion_rules": {
    "no_active_episode_overlap": "Control cases must not be inside an active positive master episode (neither anchor nor constituent observation in 21-session window)",
    "no_identical_observation_reuse": "An observation key (immutable_security_id, as_of_date, cutoff_time) cannot be reused across cases",
    "no_predictive_matching": "Controls must not be matched on predictive variables such as momentum, price structure, volume pattern, earnings surprise, news, or fundamentals",
    "rolling_window_avoidance": "Repeated reuse of one ticker within a rolling 21-session review window is avoided where possible"
  },
  "pilot_study_contract": {
    "sample_size": 24,
    "quota_per_stratum": 6,
    "strata_counts": {
      "positive_master_episode": 6,
      "near_miss": 6,
      "adverse_trap": 6,
      "ordinary_non_mover": 6
    },
    "pilot_random_seed": 20261003,
    "ticker_diversity_policy": "Strict preference for 24 distinct tickers across the 24 pilot cases (no ticker appearing more than once)",
    "annual_diversity_policy": "At least one case from each development year (2016, 2017, 2018, 2019, 2020) per stratum",
    "case_id_pattern": "D3A-PILOT-{03d}",
    "case_id_range": ["D3A-PILOT-001", "D3A-PILOT-024"],
    "case_id_opacity_requirement": "Case IDs must NOT encode ticker, date, class, outcome, sector, or year",
    "deterministic_shuffling": "After class-balanced selection, perform exactly one deterministic seeded shuffle using seed 20261003 so presentation order does not reveal stratum",
    "exclusion_from_main_study": "All 24 pilot source observation keys are permanently excluded from the future 240-case main sample"
  },
  "future_main_study_contract": {
    "main_study_sample_size": 240,
    "future_main_seed": 20261004,
    "strata_counts": {
      "positive_master_episode": 120,
      "ordinary_non_mover": 40,
      "near_miss": 40,
      "adverse_trap": 40
    },
    "batching_target": "12 batches of 20 cases",
    "ticker_frequency_limit": "Normally no ticker more than twice",
    "execution_status": "NOT_EXECUTED_IN_THIS_PR",
    "generation_gate": "Requires formal Gary authorization and completed pilot workflow review before generation"
  },
  "anonymization_and_blinding": {
    "hidden_fields": [
      "ticker",
      "company_name",
      "immutable_security_id",
      "exact_calendar_date",
      "future_bars",
      "target_outcome",
      "true_class",
      "mfe_pct",
      "mae_pct",
      "future_return",
      "time_to_target",
      "answer_key_metadata"
    ],
    "relative_time_indexing": {
      "enabled": true,
      "labels": ["T-60", "...", "T-1", "T0"],
      "cutoff_bar": "T0",
      "future_bar_leakage_prohibited": true
    },
    "price_normalization": {
      "enabled": true,
      "base_bar": "T-60",
      "normalized_base_price": 100.0,
      "preserves_returns_and_ratios": true
    },
    "stage_a_content": {
      "name": "Anonymized Technical and Market View",
      "included": [
        "normalized_ohlc_bars",
        "relative_volume_history",
        "atr_pct_volatility_context",
        "moving_average_trend_context",
        "momentum_return_context",
        "spy_market_context",
        "pit_sector_context_where_valid",
        "data_quality_warnings"
      ],
      "prohibited": [
        "stage_b_fundamentals",
        "security_identity",
        "exact_dates",
        "future_bars",
        "target_outcome"
      ]
    },
    "stage_b_content": {
      "name": "Point-in-Time Fundamental and Event Context",
      "preserves_stage_a": true,
      "added_pit_fields": [
        "market_cap_cohort",
        "trading_history_cohort",
        "pit_earnings_schedule_status",
        "pit_earnings_announcement_timing",
        "pit_sessions_to_earnings",
        "data_confidence_and_coverage_metadata"
      ],
      "missing_policy": "Missing fields remain strictly null / unknown; never zero; no external provider calls"
    }
  },
  "reviewer_label_schema": {
    "fields": {
      "surface_decision": {
        "type": "string",
        "allowed_values": ["surface", "do_not_surface"]
      },
      "visible_state_if_surfaced": {
        "type": "string",
        "nullable": true,
        "allowed_values": ["Enter Now", "Armed", "Qualified Waitlist", null]
      },
      "expected_target_pct": {
        "type": "integer",
        "nullable": true,
        "allowed_values": [10, 20, 30, null]
      },
      "expected_horizon_sessions": {
        "type": "integer",
        "nullable": true,
        "allowed_values": [5, 10, 21, null]
      },
      "qualitative_confidence": {
        "type": "integer",
        "range": [1, 5]
      },
      "setup_archetype": {
        "type": "string",
        "allowed_values": ["setup_archetype", "other", "unclear"]
      },
      "entry_plan": {
        "type": "string"
      },
      "trigger_or_zone": {
        "type": "string"
      },
      "max_validity_sessions": {
        "type": "integer",
        "max": 5
      },
      "gap_handling": {
        "type": "string"
      },
      "invalidation": {
        "type": "string"
      },
      "positive_reasons": {
        "type": "list_of_strings",
        "max_items": 3
      },
      "material_risks_counterarguments": {
        "type": "string",
        "required_when_material_risks_visible": true
      }
    },
    "storage_rule": "Stage A and Stage B labels are stored as separate immutable review records"
  },
  "answer_key_isolation_contract": {
    "git_policy": "Answer key must NEVER be committed to Git. Stored strictly in gitignored external research data area.",
    "external_path_pattern": "data/research/long_002d3a/{run_id}/pilot_answer_key.json",
    "committed_commitment_file": "answer_key_commitment.json",
    "commitment_fields": [
      "relative_external_path",
      "byte_count",
      "sha256",
      "row_count",
      "schema_version"
    ],
    "outcome_reveal_policy": "NO per-case reveal, running accuracy, or class hints during review. Outcomes remain unrevealed until all labels are locked."
  },
  "output_paths": {
    "committed_safe_artifacts_dir": "docs/research/artifacts/LONG-002D3A/{run_id}/",
    "external_gitignored_dir": "data/research/long_002d3a/{run_id}/"
  }
