  "liquidity_ranking": {
    "rank_metric": "median regular-session dollar volume over previous 20 complete XNYS sessions",
    "dollar_volume_formula": "session_dollar_volume = regular_session_final_close * sum(regular_session_volume)",
    "rank_top_n": 50,
    "prior_close_min_usd": 5.0,
    "prior_20_sessions_median_dollar_volume_min_usd": 50000000.0,
    "prior_sessions_count": 20,
    "information_cutoff": "before the first XNYS regular session of the effective month",
    "ranking_timeframe": "30Min",
    "ranking_feed": "sip",
    "ranking_adjustment": "raw",
    "ranking_timeframe_parity_probe": {
      "enabled": true,
      "sample_symbols": ["SPY", "AAPL", "JPM"],
      "sample_window": {
        "start": "2024-06-03",
        "end": "2024-06-28"
      },
      "parity_fields": ["regular_session_final_close", "sum_regular_session_volume"],
      "reference_timeframe": "5Min",
      "tolerance_pct": 0.1,
      "fallback_on_failure": "5Min"
    },
    "tie_break_rule": "ticker ascending (lexicographic)",
    "shortfall_policy": "If fewer than 50 stocks qualify, preserve the shortfall explicitly; do not relax thresholds or fill with lower-ranked symbols"
  },
  "ohlcv_policy": {
    "timeframe": "5Min",
    "feed": "sip",
    "adjustment": "raw",
    "sort": "asc",
    "page_limit": 10000,
    "timezone_storage": "UTC",
    "timezone_session_interpretation": "America/New_York",
    "regular_session_start": "09:30",
    "regular_session_end": "16:00",
    "exclude_early_close_sessions": true,
    "exclude_premarket_bars": true,
    "exclude_after_hours_bars": true,
    "bar_timestamp_semantics": "bar_start",
    "no_missing_bar_fabrication": true,
    "no_silent_zero_filling": true,
    "no_silent_provider_fallback": true,
    "no_iex_substitution": true,
    "asof_policy": "Use the effective PIT date (YYYY-MM-DD) as the asof parameter for every request. Record requested ticker, effective month, PIT date, requested asof, and returned symbol identity. Reject rows where returned symbol identity does not match requested ticker.",
    "warmup_sessions": 20
  },
  "ranking_download_efficiency": {
    "use_batched_alpaca_multi_symbol_pagination": true,
    "multi_symbol_batch_size": 400,
    "ranking_timeframe_is_coarser_than_5min": true,
