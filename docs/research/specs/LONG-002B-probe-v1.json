      "Historical ticker/name change",
      "Split or reverse split",
      "Spin-off or special distribution",
      "Merger/acquisition or delisting",
      "At least one excluded security type (ETF, ETN, preferred, warrant, unit, closed-end fund, pre-merger SPAC)"
    ],
    "locked_panel": [
