  },
  "hard_network_budget": {
    "max_preferred_plus_named_fallbacks_per_family": "1 preferred + 2 fallbacks",
    "max_probe_securities": 12,
    "max_as_of_dates_per_security": 4,
    "max_total_http_requests": 120,
    "max_retries_for_transient_failure": 1,
    "no_retry_for": [
      "authentication",
      "entitlement",
      "configuration",
      "malformed response",
      "unsupported capability"
    ],
    "max_runtime_minutes": 30,
    "stop_on_minimum_usable": true,
    "no_extra_provider_hunting_without_gary_approval": true
  },
  "expected_safe_artifacts": [
    "docs/research/specs/LONG-002B-probe-v1.json",
    "docs/research/specs/LONG-002B-data-contract-v1.json",
    "docs/research/LONG-002B-DATA-FEASIBILITY.md",
    "docs/research/artifacts/LONG-002B/<run-id>/probe_manifest.json",
    "docs/research/artifacts/LONG-002B/<run-id>/provider_contract_matrix.csv",
