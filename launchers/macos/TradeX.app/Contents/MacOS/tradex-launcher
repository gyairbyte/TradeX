#!/bin/bash
# TradeX launcher (macOS)
# Starts the Streamlit dashboard and opens the browser.
#
# Resolves the project root in this order:
#   1. $TRADEX_HOME environment variable
#   2. ~/.tradex/config  (single line: TRADEX_HOME=/abs/path/to/repo)
#   3. Walking up from the .app bundle (works when launched in-place from the repo)
#
# This makes the .app safe to copy anywhere — /Applications, Desktop, Dock —
# as long as one of (1) or (2) is set, OR the .app stays inside the repo.

set -e

LOG_DIR="$HOME/.tradex"
LOG_FILE="$LOG_DIR/dashboard.log"
mkdir -p "$LOG_DIR"

# --- resolve project root ---
PROJECT_ROOT=""

# 1. Environment variable
if [ -n "$TRADEX_HOME" ] && [ -d "$TRADEX_HOME" ]; then
    PROJECT_ROOT="$TRADEX_HOME"
fi

# 2. User config file
if [ -z "$PROJECT_ROOT" ] && [ -f "$HOME/.tradex/config" ]; then
    CONFIG_HOME="$(grep -E '^TRADEX_HOME=' "$HOME/.tradex/config" | head -1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
    # Expand ~ if the user wrote a tilde-path.
    CONFIG_HOME="${CONFIG_HOME/#\~/$HOME}"
    if [ -n "$CONFIG_HOME" ] && [ -d "$CONFIG_HOME" ]; then
        PROJECT_ROOT="$CONFIG_HOME"
    fi
fi

# 3. Walk up from the .app bundle
if [ -z "$PROJECT_ROOT" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    CANDIDATE="$(cd "$SCRIPT_DIR/../../../../.." 2>/dev/null && pwd)" || CANDIDATE=""
    if [ -n "$CANDIDATE" ] && [ -f "$CANDIDATE/pyproject.toml" ] && [ -d "$CANDIDATE/tradex" ]; then
        PROJECT_ROOT="$CANDIDATE"
    fi
fi

if [ -z "$PROJECT_ROOT" ]; then
    osascript -e 'display alert "TradeX cannot start" message "Could not locate the TradeX project directory.\n\nFix: create ~/.tradex/config with a single line:\n  TRADEX_HOME=/absolute/path/to/tradex\n\nOr set the TRADEX_HOME environment variable." as critical'
    exit 1
fi

VENV_STREAMLIT="$PROJECT_ROOT/.venv/bin/streamlit"
DASHBOARD="$PROJECT_ROOT/tradex/ui/dashboard.py"

if [ ! -x "$VENV_STREAMLIT" ]; then
    osascript -e "display alert \"TradeX cannot start\" message \"Could not find streamlit at:\n$VENV_STREAMLIT\n\nRun \`uv sync\` (or \`pip install -e .\`) in the project directory first.\" as critical"
    exit 1
fi

if [ ! -f "$DASHBOARD" ]; then
    osascript -e "display alert \"TradeX cannot start\" message \"Dashboard not found at $DASHBOARD\" as critical"
    exit 1
fi

# If something is already on :8501, just open the browser and exit.
if lsof -iTCP:8501 -sTCP:LISTEN -n -P >/dev/null 2>&1; then
    open "http://localhost:8501"
    exit 0
fi

cd "$PROJECT_ROOT"

# Launch Streamlit detached so the .app process can exit cleanly.
# --server.headless=true tells Streamlit not to auto-open a browser;
# we open it ourselves once the port is live.
nohup "$VENV_STREAMLIT" run "$DASHBOARD" \
    --server.headless=true \
    --server.port=8501 \
    >>"$LOG_FILE" 2>&1 &

# Wait up to ~20s for the port to come up, then open the browser.
for _ in $(seq 1 40); do
    if lsof -iTCP:8501 -sTCP:LISTEN -n -P >/dev/null 2>&1; then
        open "http://localhost:8501"
        exit 0
    fi
    sleep 0.5
done

osascript -e "display alert \"TradeX did not start in time\" message \"Check the log at $LOG_FILE\" as critical"
exit 1
